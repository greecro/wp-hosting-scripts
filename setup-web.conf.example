# setup-web.conf — Vorlage für non-interaktiven Web-VM-Aufbau
# Aufruf:  sudo bash setup-web.sh --config setup-web.conf
#
# Gesetzte Werte werden NICHT mehr abgefragt. Leere/fehlende Pflichtfelder
# brechen mit klarer Fehlermeldung ab. Datei mit `chmod 600` schützen (enthält Secrets).
#
# Die Datei wird per `source` eingelesen (Bash-Syntax). Werte mit Leerzeichen oder
# Sonderzeichen (z.B. SSH_PUB_KEY, SLACK_WEBHOOK_URL mit Slashes) MÜSSEN in doppelte
# Anführungszeichen: VAR="wert mit leerzeichen".

# ── VM-Typ (Pflicht): wordpress | woocommerce ──
VM_TYPE=woocommerce

# ── Datenbank-VM (Pflicht) ──
DB_HOST=192.168.1.100
DB_ADMIN_USER=wpadmin
DB_ADMIN_PASS=CHANGE_ME

# ── WordPress-Standard-Admin (Pflicht) ──
WP_ADMIN_EMAIL=admin@deine-domain.de

# ── NPM / Real-IP (optional; leer = Auto-Detect interaktiv bzw. 127.0.0.1) ──
NPM_IP=192.168.1.50

# ── Benachrichtigungen (optional): Slack Incoming Webhook für Backup-/Disk-/SSL-Alerts ──
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── SEOpress Pro Lizenz-Key (optional) ──
SEOPRESS_KEY=

# ── Fluent Forms Pro Lizenz-Key (optional) ──
# Wird pro Site in die WP-Option geschrieben UND beim Lizenzserver aktiviert.
FLUENTFORM_KEY=

# ── Zentrale Matomo-Instanz (optional; Host OHNE https:// und ohne Slash) ──
# Nur informativ in /etc/wp-hosting/config. Matomo-Site-Anlage + SEOpress-Tracking
# laufen zentral über provision-endpoint.sh (der Matomo-Token bleibt dort, nicht auf der VM).
MATOMO_URL=analytics.deine-domain.de

# ── Remote-Backup (Pflicht): RCLONE_REMOTE = r2 | s3backup | sftpbackup ──
RCLONE_REMOTE=r2

# -- R2 (wenn RCLONE_REMOTE=r2) --
R2_ACCOUNT_ID=CHANGE_ME
R2_KEY_ID=CHANGE_ME
R2_KEY_SECRET=CHANGE_ME
R2_BUCKET=wp-backups

# -- S3 (wenn RCLONE_REMOTE=s3backup) --
# S3_REGION=eu-central-1
# S3_BUCKET=wp-backups
# S3_KEY_ID=CHANGE_ME
# S3_KEY_SECRET=CHANGE_ME
# S3_ENDPOINT=                # leer = AWS-Standard

# -- SFTP (wenn RCLONE_REMOTE=sftpbackup) --
# SFTP_HOST=backup.example.com
# SFTP_USER=bkp
# SFTP_PATH=/backups
# SFTP_PORT=22                # SSH-Key /root/.ssh/id_rsa muss am Ziel hinterlegt sein

# ── Plugin-/Theme-/Media-Buckets (bei RCLONE_REMOTE=r2 optional — Default wp-plugins/wp-themes/media) ──
PLUGIN_BUCKET=wp-plugins
THEME_BUCKET=wp-themes
# MEDIA_BUCKET: Logo/Favicon pro Site, ein Unterordner je Domain (media/<domain>/),
# gezielter Pull statt Full-Mirror — siehe sync-media.sh --domain <domain>.
MEDIA_BUCKET=media

# ── Dashy-Management-Zugang (optional; beide Werte zusammen oder keiner) ──
# Public Key des Dashy-Hosts (eine Zeile, in Anführungszeichen) und seine IP/CIDR.
# Richtet User "dashy" mit restriktivem Key, Read-only-wp-cli-Wrapper und
# Site-Registry ein — siehe setup-dashy-access.sh (auch einzeln nachrüstbar).
DASHY_PUB_KEY=""
DASHY_FROM=

# ── Monitoring (optional): IP des Netdata-Parents. Nur wenn gesetzt wird Port
#    19999 in der Firewall für genau diese Quelle geöffnet (sonst bleibt 19999 zu). ──
NETDATA_PARENT_IP=

# ── age-Backup-Verschlüsselung: true | false ──
ENABLE_AGE=false

# ── age Public-Key (optional; muss mit age1 beginnen) ──
# Gesetzt + ENABLE_AGE=true → Backups werden gegen diesen Stack-Recipient verschlüsselt
# und es wird KEIN Secret-Key auf der VM erzeugt (empfohlen — Secret bleibt zentral im
# Passwort-Manager). Leer + ENABLE_AGE=true → lokales Keypair, Secret liegt auf der VM.
AGE_RECIPIENT=

# ── SSH Public Key für ubuntu-User (optional; wegen Leerzeichen IMMER quoten) ──
# Beispiel: SSH_PUB_KEY="ssh-ed25519 AAAA... user@host"
SSH_PUB_KEY=
