#!/usr/bin/env bash
# dashy-wp-update — Einzel-Update eines Plugins, Themes oder des WordPress-Cores mit Snapshot
# und Rollback, der erste und einzige Schreibpfad des Management-Dashboards "Dashy".
#
# Aufruf (über sudoers, als root; der SSH-Weg führt über dashy-gate):
#   sudo -n /usr/local/sbin/dashy-wp-update <domain> plugin|theme <slug>
#   sudo -n /usr/local/sbin/dashy-wp-update <domain> core latest|<x.y.z>
#   sudo -n /usr/local/sbin/dashy-wp-update <domain> rollback <snapshot-id>      (nur Dateien)
#   sudo -n /usr/local/sbin/dashy-wp-update <domain> rollback-db <snapshot-id>   (Dateien und Datenbank)
#
# Zuschnitt (bewusst eng):
#   - genau EIN Slug je Aufruf: kein --all, keine Installation
#   - Core nur auf eine Version, die `wp core check-update` anbietet (kein Downgrade, kein --force);
#     `latest` nimmt die neueste; danach `wp core update-db`
#   - Snapshot vor dem Update unter /var/backups/wp-hosting/<domain>/dashy-<YYYYmmdd-HHMMSS>-<slug>/
#     (root 700): Plugin/Theme = tar.gz des Verzeichnisses; Core = tar.gz von wp-admin, wp-includes
#     und den Root-Dateien, die `wp core update` anfasst (*.php außer wp-config.php, license.txt,
#     readme.html, feste Liste CORE_ROOT_FILES; fremde *.php im Webroot bleiben draußen); dazu immer ein DB-Dump
#     (als Site-User per `wp db export -`, kein Passwort in argv).
#     Retention je Domain: die letzten 5 Plugin-/Theme-Snapshots und getrennt die letzten 2 Core-Snapshots
#   - Was ein Core-Rollback NICHT zurückdreht: Sprachpakete unter wp-content/languages, bei Major-Releases neue
#     Bundled-Themes, und Root-Dateien, die erst die neue Version angelegt hat (bleiben liegen, harmlos)
#   - Fehlertexte im JSON: nur ein fester Kopf („Error: …" ohne Anführungszeichen) bzw. der mysql-Fehlercode,
#     nie der Freitext von mysql/mysqldump (zitiert Anweisungen und Werte, also Datenbankinhalt)
#   - Root fasst im Webroot NICHTS an: tar, mktemp, mv und rm dort laufen als Site-User
#     (runuser), damit ein Symlink-Tausch durch den Site-User nie Root-Rechte bekommt;
#     root schreibt und liest nur das Snapshot-Verzeichnis
#   - Update als Site-User (runuser, env -i, erzwungenes --path, keine wp-cli-Config)
#   - Smoke-Test danach: Status vorher = nachher (Plugin/Theme), `core is-installed`, HTTP-Status
#     der Startseite lokal über nginx (Host-Header), Versionsvergleich
#   - rollback: Dateien aus dem tar zurück (als Site-User in Temp entpacken, Mitglieder vorher
#     prüfen, dann mv-Tausch); funktioniert auch, wenn das Zielverzeichnis fehlt (abgebrochenes
#     Update). Der DB-Dump bleibt liegen und wird im JSON genannt. Core-Snapshots nur mit rollback-db,
#     weil `wp core update-db` das Schema geändert hat.
#   - rollback-db: erst ein zusätzlicher Dump des aktuellen Stands in das Snapshot-Verzeichnis
#     (db-before-rollback-<ts>.sql.gz, im JSON als db_dump), dann Dateien wie bei rollback, dann
#     `wp db import -` aus dem Dump des Snapshots (stdin, als Site-User). Inhalte seit dem Snapshot
#     gehen verloren; Tabellen, die erst danach entstanden sind, bleiben stehen. Auf Sites mit Typ
#     "woocommerce" wird rollback-db abgelehnt (Exit 77): Bestellungen und Kunden wären unwiderruflich weg.
#     Der Sicherungsdump ist nur manuell per `wp db import` einspielbar (bewusst kein Dashy-Pfad).
#   - Ausgabe genau eine JSON-Zeile:
#     {ok, kind, slug, old_version, new_version, snapshot, db_dump, smoke:{…}, error}
#   - Ablehnung = Exit 77 ohne JSON; fehlgeschlagenes Update = Exit 1 mit JSON
#   - jede Ausführung und Ablehnung als Zeile in journald (logger -t dashy); Fremdtext
#     (wp-Ausgabe, Versionen) kommt nur geprüft bzw. maskiert ins Log und ins JSON
#   - ein Lock je Domain (/run/lock/wp-hosting/<domain>.lock, auch von update-wp.sh genutzt)
#   - SIGHUP/SIGPIPE (SSH-Abbruch) werden ignoriert: ein begonnener Lauf läuft zu Ende
set -euo pipefail
trap '' HUP PIPE
cd /

WP_BIN="/usr/local/bin/wp"
WWW_ROOT="/var/www"
SITES_DIR="/etc/wp-hosting/sites"
BACKUP_ROOT="/var/backups/wp-hosting"
LOCK_DIR="/run/lock/wp-hosting"
KEEP=5
KEEP_CORE=2
MIN_FREE_KB=524288
EXIT_DENIED=77
HTTP_TIMEOUT=20

SLUG_RE='^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$'
SNAP_RE='^dashy-[0-9]{8}-[0-9]{6}-[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$'
USER_RE='^[a-z_][a-z0-9_]{0,31}$'
DOMAIN_RE='^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$'
VERSION_RE='^[0-9A-Za-z.+_~-]{1,40}$'
CORE_VER_RE='^[0-9]+(\.[0-9]+){1,2}$'
STATUS_RE='^[a-z-]{1,20}$'
# Root-Dateien, die zu WordPress gehören und die `wp core update` anfasst — feste Liste, damit fremde *.php im Webroot
# (db-config.php, adminer.php, eigene Konfig) weder ins Snapshot noch beim Rollback über den aktuellen Stand gehen
CORE_ROOT_FILES=(index.php license.txt readme.html wp-activate.php wp-blog-header.php wp-comments-post.php
    wp-config-sample.php wp-cron.php wp-links-opml.php wp-load.php wp-login.php wp-mail.php wp-settings.php
    wp-signup.php wp-trackback.php xmlrpc.php)
CORE_REQUIRED=(index.php wp-load.php wp-settings.php)
is_core_root_file() { local f; for f in "${CORE_ROOT_FILES[@]}"; do [[ "$1" == "$f" ]] && return 0; done; return 1; }

# ── Helfer ──────────────────────────────────────────────────────────────────
now_ms() { local us="${EPOCHREALTIME:-0.0}"; us="${us/./}"; echo $(( 10#${us} / 1000 )); }
json_escape() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; s="${s//$'\t'/\\t}"; s="${s//$'\n'/\\n}"; s="${s//$'\r'/}"; printf '%s' "$s"; }
# Fremdtext (wp-Ausgabe) für das JSON: URLs und Schlüssel maskiert, nur druckbare Zeichen, begrenzt
clean() {
    local out
    out=$(printf '%s' "$1" \
        | sed -E 's#https?://[^ "'"'"'<>]+#<url>#g; s/(key|token|license|licence|password|secret|pass)=[^ &"]+/\1=<maskiert>/Ig' \
        | tr -d '\000-\011\013-\037\177' | tr '\n' ' ')
    printf '%s' "${out:0:300}"   # Zeichen, nicht Bytes (cut -c schneidet UTF-8 mitten im Zeichen)
}
# Fehlermeldung von wp-cli/mysql fürs JSON: NUR ein fester Kopf ohne Anführungszeichen bzw. nur der mysql-Fehlercode.
# SQL-Fehler zitieren Anweisungstext oder Werte (Duplicate entry '…', near '…') und damit Datenbankinhalt — der bleibt draußen.
wp_msg() {  # erst ein "Error:", sonst das erste "Warning:" (pipefail: grep ohne Treffer kippt die Zuweisung)
    local o
    o=$(printf '%s' "$1" | grep -oE '^Error: [A-Za-z0-9 .,()-]{1,80}' | head -1) \
        || o=$(printf '%s' "$1" | grep -oE '^Warning: [A-Za-z0-9 .,()-]{1,80}' | head -1) || o=""
    printf '%s' "$o"
}
sql_code() { printf '%s' "$1" | grep -oE 'ERROR [0-9]{4} \([0-9A-Z]{5}\)( at line [0-9]+)?' | head -1 || true; }
# Versions-/Statusfeld fürs Log: nur, wenn es wie eines aussieht
safe() { [[ "$1" =~ $2 ]] && printf '%s' "$1" || printf '?'; }

LOG_DOMAIN="-"; LOG_CMD="-"; T_START=$(now_ms)
log_line() {  # log_line <exit> <reason> <extra>
    logger -t dashy -p auth.info -- \
        "site=${LOG_DOMAIN} caller=${SUDO_USER:-?} runas=root exit=$1 ms=$(( $(now_ms) - T_START )) reason=$2 cmd=${LOG_CMD} $3" 2>/dev/null || true
}
deny() {  # deny <reason> — feste Gründe, keine Argumentwerte ins Log, nur Anzahl und Hash
    local h; h=$(printf '%s\0' "${ORIG_ARGS[@]}" | sha256sum | cut -c1-12)
    log_line "$EXIT_DENIED" "$1" "argc=${#ORIG_ARGS[@]} sha=${h}"
    echo "dashy-wp-update: abgelehnt ($1)" >&2
    exit "$EXIT_DENIED"
}

# ── Prüfung der Kommandozeile (reine Funktion, auch für --selftest) ────────
# stdout: "<mode> <domain> <arg>" (ok) bzw. Grund ohne Argumentwerte (abgelehnt); Rückgabe 0/1.
check_args() {
    [[ $# -eq 3 ]] || { echo "genau drei argumente: <domain> plugin|theme|core|rollback|rollback-db <slug|version|snapshot-id>"; return 1; }
    local domain="$1" mode="$2" arg="$3"
    [[ -n "$domain" && -n "$mode" && -n "$arg" ]] || { echo "leeres argument"; return 1; }
    [[ "$domain" =~ $DOMAIN_RE && "$domain" != *..* && ${#domain} -le 253 ]] || { echo "ungültige domain"; return 1; }
    case "$mode" in
        plugin|theme)
            [[ "$arg" =~ $SLUG_RE && "$arg" != . && "$arg" != .. ]] || { echo "ungültiger slug"; return 1; } ;;
        core)
            [[ "$arg" == latest || "$arg" =~ $CORE_VER_RE ]] || { echo "ungültige version"; return 1; } ;;
        rollback|rollback-db)
            [[ "$arg" =~ $SNAP_RE ]] || { echo "ungültige snapshot-id"; return 1; } ;;
        *) echo "modus nicht erlaubt"; return 1 ;;
    esac
    echo "$mode $domain $arg"
    return 0
}

# Archiv-Mitglieder eines Plugin-/Theme-Snapshots: ausschließlich "<slug>" bzw. "<slug>/…",
# nie "..", nie absolut (reine Funktion)
check_members() {  # check_members <slug> <listing>
    local slug="$1" members="$2"
    [[ -n "$members" ]] || return 1
    grep -qE '(^|/)\.\.(/|$)|^/' <<<"$members" && return 1
    grep -qvE "^${slug//./\\.}(/|$)" <<<"$members" && return 1
    return 0
}

# Archiv-Mitglieder eines Core-Snapshots (reine Funktion, wird vom Selftest unten geprüft).
# Erlaubt sind genau die Pfade, die `wp core update` anfasst: "wp-admin", "wp-admin/…",
# "wp-includes", "wp-includes/…" und Root-Dateien aus CORE_ROOT_FILES (kein Unterpfad, nie wp-config.php).
# Beide Verzeichnisse und die Pflichtdateien CORE_REQUIRED müssen vorkommen; ".." und absolute Pfade sind tabu.
# Rückgabe 0 = Archiv darf zurückgespielt werden, 1 = ablehnen.
check_core_members() {  # check_core_members <listing>
    local members="$1" m r has_admin=0 has_includes=0
    [[ -n "$members" ]] || return 1
    while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        [[ "$m" != /* ]] || return 1
        [[ ! "$m" =~ (^|/)\.\.(/|$) ]] || return 1
        case "$m" in
            wp-admin|wp-admin/*)       has_admin=1 ;;
            wp-includes|wp-includes/*) has_includes=1 ;;
            */*)                       return 1 ;;   # Root-Datei mit Unterpfad (wp-content/…, sub/…)
            *)                         is_core_root_file "$m" || return 1 ;;
        esac
    done <<<"$members"
    [[ $has_admin -eq 1 && $has_includes -eq 1 ]] || return 1
    for r in "${CORE_REQUIRED[@]}"; do grep -qxF "$r" <<<"$members" || return 1; done
    return 0
}

selftest() {
    local fails=0
    t() {  # t <erwartet: ok|deny> <args…>
        local want="$1"; shift
        local out rc=0
        out=$(check_args "$@") || rc=1
        if { [[ "$want" == ok && $rc -eq 0 ]] || [[ "$want" == deny && $rc -eq 1 ]]; }; then
            printf '  ok    %-5s %s\n' "$want" "$*"
        else
            printf '  FAIL  %-5s %s  -> %s\n' "$want" "$*" "$out"; fails=$((fails+1))
        fi
    }
    m() {  # m <erwartet: ok|deny> <slug> <listing>
        local want="$1" rc=0; check_members "$2" "$3" || rc=1
        if { [[ "$want" == ok && $rc -eq 0 ]] || [[ "$want" == deny && $rc -eq 1 ]]; }; then
            printf '  ok    %-5s members %s: %s\n' "$want" "$2" "${3//$'\n'/ | }"
        else
            printf '  FAIL  %-5s members %s: %s\n' "$want" "$2" "${3//$'\n'/ | }"; fails=$((fails+1))
        fi
    }
    c() {  # c <erwartet: ok|deny> <listing>
        local want="$1" rc=0; check_core_members "$2" || rc=1
        if { [[ "$want" == ok && $rc -eq 0 ]] || [[ "$want" == deny && $rc -eq 1 ]]; }; then
            printf '  ok    %-5s core-members: %s\n' "$want" "${2//$'\n'/ | }"
        else
            printf '  FAIL  %-5s core-members: %s\n' "$want" "${2//$'\n'/ | }"; fails=$((fails+1))
        fi
    }
    e() {  # e <erwartet> <funktion> <eingabe> — Fehlertext-Filter: Ausgabe muss exakt stimmen
        local got; got=$("$2" "$3")
        if [[ "$got" == "$1" ]]; then printf '  ok    %s -> %s\n' "$2" "$got"
        else printf '  FAIL  %s -> %s (erwartet %s)\n' "$2" "$got" "$1"; fails=$((fails+1)); fi
    }
    echo "dashy-wp-update selftest"
    e "Error: Update package not available." wp_msg $'Warning: x\nError: Update package not available.'
    e "Error: WordPress database error " wp_msg "Error: WordPress database error 'Duplicate entry DUMMYSECRET' for query INSERT"
    e "" wp_msg "irgendwas ohne kopf DUMMYSECRET"
    e "ERROR 1064 (42000) at line 3" sql_code "ERROR 1064 (42000) at line 3: You have an error in your SQL syntax near 'DUMMYSECRET' at line 3"
    e "ERROR 1062 (23000)" sql_code "ERROR 1062 (23000): Duplicate entry 'DUMMYSECRET' for key 'PRIMARY'"
    e "" sql_code "Error: Database connection error (DUMMYSECRET)"
    t ok   example.com plugin two-factor
    t ok   example.com plugin Akismet_2.0
    t ok   example.com theme blocksy
    t ok   example.com core latest
    t ok   example.com core 7.1.3
    t ok   example.com core 7.2
    t ok   example.com rollback dashy-20261012-181500-two-factor
    t ok   example.com rollback dashy-20261012-181500-blocksy
    t ok   example.com rollback-db dashy-20261012-181500-two-factor
    t ok   example.com rollback-db dashy-20261014-090000-core
    t deny example.com plugin
    t deny example.com plugin --all
    t deny example.com plugin "two-factor --all"
    t deny example.com plugin ../hello
    t deny example.com plugin .
    t deny example.com plugin ..
    t deny example.com plugin .hidden
    t deny example.com plugin "a;id"
    t deny example.com plugin "a b"
    t deny example.com plugin ""
    t deny example.com core update
    t deny example.com core 7
    t deny example.com core 7.1.3.1
    t deny example.com core "7.1.3 --force"
    t deny example.com core --force
    t deny example.com core v7.1.3
    t deny example.com core 7.1.3-beta1
    t deny example.com core ""
    t deny example.com plugin two-factor extra
    t deny example.com install two-factor
    t deny example.com update two-factor
    t deny example.com rollbackdb dashy-20261012-181500-two-factor
    t deny example.com db dashy-20261012-181500-two-factor
    t deny "example.com/.." plugin two-factor
    t deny "Example.com" plugin two-factor
    t deny "../etc" plugin two-factor
    t deny example.com rollback two-factor
    t deny example.com rollback dashy-20261012-181500-../x
    t deny example.com rollback "dashy-20261012-181500-x y"
    t deny example.com rollback /var/backups/wp-hosting/x
    t deny example.com rollback-db two-factor
    t deny example.com rollback-db dashy-20261012-181500-../x
    t deny example.com rollback-db /var/backups/wp-hosting/x
    t deny "" plugin two-factor
    m ok   two-factor $'two-factor/\ntwo-factor/readme.txt\ntwo-factor/inc/x.php'
    m ok   two-factor $'two-factor'
    m deny two-factor $'two-factor/\ntwo-factor/../../etc/x'
    m deny two-factor $'two-factor/\n../x'
    m deny two-factor $'two-factor/\n/etc/passwd'
    m deny two-factor $'two-factor/\ntwo-factor-pro/x'
    m deny two-factor $'other/x'
    m deny two-factor ''
    m deny two.factor $'twoXfactor/x'
    local base=$'wp-admin/\nwp-admin/index.php\nwp-includes/\nwp-includes/version.php\nindex.php\nwp-load.php\nwp-settings.php'
    c ok   "$base"$'\nwp-login.php\nlicense.txt\nreadme.html\nxmlrpc.php\nwp-config-sample.php'
    c ok   $'wp-admin\nwp-includes\nindex.php\nwp-load.php\nwp-settings.php'
    c deny $'wp-admin/\nwp-admin/index.php\nindex.php\nwp-load.php\nwp-settings.php'   # wp-includes fehlt
    c deny $'wp-includes/\nindex.php\nwp-load.php\nwp-settings.php'                     # wp-admin fehlt
    c deny $'wp-admin/\nwp-includes/\nindex.php'                                        # Pflichtdateien fehlen
    c deny $'wp-admin/\nwp-includes/\nwp-load.php\nwp-settings.php'                     # index.php fehlt
    c deny "$base"$'\nwp-config.php'
    c deny "$base"$'\ndb-config.php'
    c deny "$base"$'\nadminer.php'
    c deny "$base"$'\nwp-content/plugins/x.php'
    c deny "$base"$'\nwp-content'
    c deny "$base"$'\nwp-admin/../wp-config.php'
    c deny "$base"$'\n../x.php'
    c deny "$base"$'\n/etc/passwd'
    c deny "$base"$'\n.htaccess'
    c deny "$base"$'\nwp-admin-x/y.php'
    c deny "$base"$'\nsub/index.php'
    c deny "$base"$'\nindex.php.bak'
    c deny ''
    echo "fehler: ${fails}"
    [[ $fails -eq 0 ]]
}

# ── Als Site-User: wp-cli gehärtet wie in dashy-wp, Dateioperationen im Webroot ──
as_user() { runuser -u "$SYSTEM_USER" -- "$@"; }
wp_user() {  # wp_user <args…>
    as_user env -i PATH=/usr/local/bin:/usr/bin:/bin HOME=/nonexistent LANG=C.UTF-8 \
            WP_CLI_CONFIG_PATH=/dev/null WP_CLI_PACKAGES_DIR=/nonexistent \
            WP_CLI_DISABLE_AUTO_CHECK_UPDATE=1 \
            "$WP_BIN" --path="$SITE_PATH" --skip-packages --no-color "$@"
}
# Kurze Antwort eines wp-Aufrufs, nie abbrechen: leer bei Fehler
wp_field() { local out; out=$(wp_user "$@" 2>/dev/null) || out=""; clean "$out"; }

site_field() {  # site_field <label> — nur erlaubte Labels, Passwortzeilen werden nie angefasst
    case "$1" in System-User|Site-Pfad|Typ) ;; *) echo "dashy-wp-update: label $1 nicht erlaubt" >&2; exit 3 ;; esac
    awk -v l="$1" 'index($0, l ":") == 1 { sub("^" l ":[ \t]*", ""); print; exit }' "$SITE_FILE"
}

http_status() {  # Startseite lokal über nginx mit Host-Header; "000" bei Verbindungsfehler
    local code
    code=$(curl -s -o /dev/null -m "$HTTP_TIMEOUT" -w '%{http_code}' -H "Host: ${DOMAIN}" -A "dashy-smoke" http://127.0.0.1/ 2>/dev/null) || code="000"
    [[ "$code" =~ ^[0-9]{3}$ ]] || code="000"
    printf '%s' "$code"
}

OK=false; ERROR=""; OLD_VERSION=""; NEW_VERSION=""; SNAPSHOT=""; DB_DUMP=""
STATUS_BEFORE=""; STATUS_AFTER=""; IS_INSTALLED=""; HTTP=""; MODE=""; SLUG=""
emit() {  # emit <exit> — erst Log, dann JSON (stdout kann bei SSH-Abbruch zu sein)
    local ok_json=false; $OK && ok_json=true
    log_line "$1" "$( $OK && echo ok || echo fehler )" \
        "slug=${SLUG} snapshot=${SNAPSHOT##*/} old=$(safe "$OLD_VERSION" "$VERSION_RE") new=$(safe "$NEW_VERSION" "$VERSION_RE") http=$(safe "$HTTP" '^[0-9]{3}$')"
    printf '{"ok":%s,"kind":"%s","slug":"%s","old_version":"%s","new_version":"%s","snapshot":"%s","db_dump":"%s","smoke":{"status_before":"%s","status_after":"%s","is_installed":"%s","http":"%s"},"error":"%s"}\n' \
        "$ok_json" "$(json_escape "$MODE")" "$(json_escape "$SLUG")" "$(json_escape "$OLD_VERSION")" "$(json_escape "$NEW_VERSION")" \
        "$(json_escape "$SNAPSHOT")" "$(json_escape "$DB_DUMP")" "$(json_escape "$STATUS_BEFORE")" "$(json_escape "$STATUS_AFTER")" \
        "$(json_escape "$IS_INSTALLED")" "$(json_escape "$HTTP")" "$(json_escape "$ERROR")" || true
    exit "$1"
}
fail() { OK=false; ERROR="$(clean "$1")"; emit 1; }
# Unerwarteter Abbruch (set -e): trotzdem Logzeile und JSON
trap 'rc=$?; [[ $rc -eq 0 || $rc -eq 1 || $rc -eq 77 ]] || { ERROR="unerwarteter abbruch (exit ${rc})"; OK=false; emit 1; }' EXIT

# ── DB-Dump als Site-User nach stdout (Passwort bleibt bei wp-cli in MYSQL_PWD), gzip als root ──
DUMP_MSG=""
dump_db() {  # dump_db <ziel.sql.gz> — 0 = Dump vollständig, 1 = fehlgeschlagen (Ziel entfernt)
    local target="$1" err rc tail_line
    err=$(mktemp "$(dirname "$target")/.dberr.XXXXXX")
    set +e
    wp_user db export - --skip-plugins --skip-themes --single-transaction --quick --add-drop-table 2>"$err" | gzip > "$target"
    rc=("${PIPESTATUS[@]}")
    set -e
    tail_line=$( { zcat "$target" 2>/dev/null | tail -n 1; } || true )
    if [[ "${rc[0]}" -ne 0 || "${rc[1]}" -ne 0 ]] || ! gzip -t "$target" 2>/dev/null || [[ "$tail_line" != *"Dump completed"* ]]; then
        DUMP_MSG="db-dump fehlgeschlagen (rc=${rc[0]}/${rc[1]}): $(grep -E 'Error|error|denied|failed' "$err" | head -1 || true)"
        rm -f "$err" "$target"
        return 1
    fi
    rm -f "$err"
    chmod 600 "$target" || return 1   # im ||-Kontext aufgerufen: set -e wirkt dort nicht
    return 0
}

# ── Datei-Rollback eines Plugin-/Theme-Snapshots (alles im Webroot als Site-User) ──
restore_item_files() {
    local members tmp old_dir
    # Listing erst in eine Variable: grep -q würde tar per SIGPIPE beenden und pipefail das Ergebnis kippen
    members=$(tar -tzf "${SNAP_DIR}/files.tar.gz" 2>/dev/null) || fail "archiv nicht lesbar"
    check_members "$SLUG" "$members" || fail "archiv enthält fremde pfade"
    tmp=$(as_user mktemp -d -p "$PARENT" ".dashy-rollback.XXXXXX") || fail "temp-verzeichnis nicht anlegbar"
    as_user tar -xzf - -C "$tmp" --no-same-owner --no-same-permissions < "${SNAP_DIR}/files.tar.gz" \
        || { as_user rm -rf -- "$tmp"; fail "entpacken fehlgeschlagen"; }
    [[ -d "${tmp}/${SLUG}" && ! -L "${tmp}/${SLUG}" ]] || { as_user rm -rf -- "$tmp"; fail "archiv ohne ${SLUG}/"; }
    old_dir="${PARENT}/.dashy-old.${SLUG}.$$"
    if [[ -e "$TARGET" ]]; then
        as_user mv -T -- "$TARGET" "$old_dir" || { as_user rm -rf -- "$tmp"; fail "verzeichnis nicht verschiebbar"; }
    fi
    if ! as_user mv -T -- "${tmp}/${SLUG}" "$TARGET"; then
        [[ -e "$old_dir" ]] && as_user mv -T -- "$old_dir" "$TARGET" || true
        as_user rm -rf -- "$tmp"
        fail "zurückkopieren fehlgeschlagen"
    fi
    as_user rm -rf -- "$tmp" "$old_dir" || true
}

# ── Datei-Rollback eines Core-Snapshots: wp-admin und wp-includes tauschen, Root-Dateien ersetzen ──
# Ablauf: entpacken in Temp → aktuelle Root-Dateien in ein eigenes Alt-Verzeichnis (mktemp, nie PID-Suffix) kopieren →
# Verzeichnisse dorthin verschieben und aus dem Temp einsetzen → Root-Dateien einsetzen. Jeder Fehler ruft undo(), das
# nur zurücktauscht, was DIESER Lauf verschoben hat (Merker, nicht Existenzprüfung). Dateien, die erst die neue Version
# angelegt hat (neue Root-Dateien, Sprachpakete, Bundled-Themes unter wp-content), bleiben nach dem Rollback liegen.
restore_core_files() {
    local members tmp old d f moved_admin=0 moved_includes=0 saved=()
    members=$(tar -tzf "${SNAP_DIR}/files.tar.gz" 2>/dev/null) || fail "archiv nicht lesbar"
    check_core_members "$members" || fail "archiv enthält fremde pfade"
    tmp=$(as_user mktemp -d -p "$SITE_PATH" ".dashy-rollback.XXXXXX") || fail "temp-verzeichnis nicht anlegbar"
    old=$(as_user mktemp -d -p "$SITE_PATH" ".dashy-old.XXXXXX") || { as_user rm -rf -- "$tmp"; fail "alt-verzeichnis nicht anlegbar"; }
    undo() {
        local x
        [[ $moved_admin -eq 1 ]] && { as_user rm -rf -- "${SITE_PATH}/wp-admin"; as_user mv -T -- "${old}/wp-admin" "${SITE_PATH}/wp-admin" || true; }
        [[ $moved_includes -eq 1 ]] && { as_user rm -rf -- "${SITE_PATH}/wp-includes"; as_user mv -T -- "${old}/wp-includes" "${SITE_PATH}/wp-includes" || true; }
        for x in "${saved[@]}"; do as_user mv -f -T -- "${old}/${x}" "${SITE_PATH}/${x}" || true; done
        as_user rm -rf -- "$tmp" "$old" || true
    }
    as_user tar -xzf - -C "$tmp" --no-same-owner --no-same-permissions < "${SNAP_DIR}/files.tar.gz" \
        || { undo; fail "entpacken fehlgeschlagen"; }
    for d in wp-admin wp-includes; do
        [[ -d "${tmp}/${d}" && ! -L "${tmp}/${d}" ]] || { undo; fail "archiv ohne ${d}/"; }
    done
    # Aktuelle Root-Dateien sichern, damit undo sie zurücklegen kann
    for f in "${CORE_ROOT_FILES[@]}"; do
        [[ -f "${SITE_PATH}/${f}" && ! -L "${SITE_PATH}/${f}" && -f "${tmp}/${f}" ]] || continue
        as_user cp -p -- "${SITE_PATH}/${f}" "${old}/${f}" || { undo; fail "root-datei nicht sicherbar"; }
        saved+=("$f")
    done
    if [[ -e "${SITE_PATH}/wp-admin" ]]; then
        as_user mv -T -- "${SITE_PATH}/wp-admin" "${old}/wp-admin" || { undo; fail "wp-admin nicht verschiebbar"; }
        moved_admin=1
    fi
    as_user mv -T -- "${tmp}/wp-admin" "${SITE_PATH}/wp-admin" || { undo; fail "wp-admin nicht zurückkopierbar"; }
    if [[ -e "${SITE_PATH}/wp-includes" ]]; then
        as_user mv -T -- "${SITE_PATH}/wp-includes" "${old}/wp-includes" || { undo; fail "wp-includes nicht verschiebbar"; }
        moved_includes=1
    fi
    as_user mv -T -- "${tmp}/wp-includes" "${SITE_PATH}/wp-includes" || { undo; fail "wp-includes nicht zurückkopierbar"; }
    # Root-Dateien einzeln einsetzen: nur Namen aus der festen Liste, nur reguläre Dateien aus dem Temp
    for f in "${CORE_ROOT_FILES[@]}"; do
        [[ -f "${tmp}/${f}" && ! -L "${tmp}/${f}" ]] || continue
        as_user mv -f -T -- "${tmp}/${f}" "${SITE_PATH}/${f}" || { undo; fail "root-datei nicht ersetzbar — dateien zurückgetauscht, datenbank unverändert"; }
    done
    # Ein abgebrochenes `wp core update` hinterlässt .maintenance: weg damit, sonst bleibt die Site im Wartungsmodus
    as_user rm -f -- "${SITE_PATH}/.maintenance" || true
    as_user rm -rf -- "$tmp" "$old" || true
}

# Root-Dateien für den Core-Snapshot: die feste Liste, soweit vorhanden und reguläre Datei (root prüft nur, tar läuft als Site-User)
core_root_files() {
    local f
    for f in "${CORE_ROOT_FILES[@]}"; do
        [[ -f "${SITE_PATH}/${f}" && ! -L "${SITE_PATH}/${f}" ]] && printf '%s\n' "$f"
    done
    return 0
}

# ── Hauptprogramm ──────────────────────────────────────────────────────────
if [[ "${1:-}" == "--selftest" ]]; then trap - EXIT; selftest; exit $?; fi
ORIG_ARGS=("$@")
[[ $EUID -eq 0 ]] || { trap - EXIT; echo "dashy-wp-update: muss als root laufen (sudo -n)" >&2; exit 2; }

CHECK=$(check_args "$@") || deny "$CHECK"
read -r MODE DOMAIN ARG <<<"$CHECK"
LOG_DOMAIN="$DOMAIN"; LOG_CMD="update:${MODE}"
TS=$(date +%Y%m%d-%H%M%S)

SITE_FILE="${SITES_DIR}/${DOMAIN}.txt"
[[ -f "$SITE_FILE" && ! -L "$SITE_FILE" ]] || deny "site unbekannt"
SYSTEM_USER=$(site_field System-User)
[[ "$SYSTEM_USER" =~ $USER_RE && "$SYSTEM_USER" != root ]] || deny "system-user ungültig"
[[ " $(id -nG "$SYSTEM_USER" 2>/dev/null) " == *" sftpusers "* ]] || deny "system-user nicht in sftpusers"
SITE_UID=$(id -u "$SYSTEM_USER")
SITE_PATH=$(site_field Site-Pfad); [[ -n "$SITE_PATH" ]] || SITE_PATH="${WWW_ROOT}/${DOMAIN}"
[[ "$SITE_PATH" == "${WWW_ROOT}/${DOMAIN}" ]] || deny "site-pfad außerhalb von ${WWW_ROOT}"
[[ -d "$SITE_PATH" && ! -L "$SITE_PATH" ]] || deny "site-pfad fehlt"
[[ "$(stat -c %u "$SITE_PATH")" == "$SITE_UID" ]] || deny "system-user besitzt site nicht"

# Lock je Domain (gemeinsam mit update-wp.sh): parallele Updates derselben Site gibt es nicht
install -d -m 700 -o root -g root "$LOCK_DIR"
exec 9>"${LOCK_DIR}/${DOMAIN}.lock"
flock -n 9 || deny "läuft bereits"

if [[ "$MODE" == rollback || "$MODE" == rollback-db ]]; then
    SNAP_DIR="${BACKUP_ROOT}/${DOMAIN}/${ARG}"
    [[ -d "$SNAP_DIR" && ! -L "$SNAP_DIR" && "$(stat -c %u "$SNAP_DIR")" == 0 ]] || deny "snapshot fehlt"
    [[ -f "${SNAP_DIR}/meta" && -f "${SNAP_DIR}/files.tar.gz" ]] || deny "snapshot unvollständig"
    # meta (root-geschrieben): "kind=", "slug=", "status=" — trotzdem gegen die Muster geprüft
    KIND=$(awk -F= '$1=="kind" && ($2=="plugin" || $2=="theme" || $2=="core") {print $2; exit}' "${SNAP_DIR}/meta")
    SLUG=$(awk -F= '$1=="slug" {print $2; exit}' "${SNAP_DIR}/meta")
    META_STATUS=$(awk -F= '$1=="status" {print $2; exit}' "${SNAP_DIR}/meta")
    [[ -n "$KIND" && "$SLUG" =~ $SLUG_RE && "$SLUG" != . && "$SLUG" != .. ]] || deny "snapshot-meta ungültig"
    [[ "$KIND" != core || "$SLUG" == core ]] || deny "snapshot-meta ungültig"
    [[ "$META_STATUS" =~ $STATUS_RE ]] || META_STATUS=""
    [[ "$KIND" != core || "$MODE" == rollback-db ]] || deny "core-snapshot nur mit rollback-db"
    [[ "$MODE" != rollback-db ]] || [[ -f "${SNAP_DIR}/db.sql.gz" ]] || deny "snapshot ohne db-dump"
    # Entscheidung 2026-10-15: kein DB-Import auf Shops — Bestellungen und Kunden seit dem Snapshot wären weg
    [[ "$MODE" != rollback-db ]] || [[ "$(site_field Typ)" != woocommerce ]] || deny "rollback-db auf woocommerce-site nicht erlaubt"
    SNAPSHOT="$SNAP_DIR"
    [[ -f "${SNAP_DIR}/db.sql.gz" ]] && DB_DUMP="${SNAP_DIR}/db.sql.gz"
elif [[ "$MODE" == core ]]; then
    KIND=core; SLUG=core
else
    KIND="$MODE"; SLUG="$ARG"
fi
if [[ "$KIND" != core ]]; then
    PARENT="${SITE_PATH}/wp-content/${KIND}s"
    TARGET="${PARENT}/${SLUG}"
    [[ -d "$PARENT" && ! -L "$PARENT" && "$(stat -c %u "$PARENT")" == "$SITE_UID" ]] || deny "${KIND}-verzeichnis fehlt oder fremder besitzer"
    if [[ "$MODE" == plugin || "$MODE" == theme ]]; then
        [[ -d "$TARGET" && ! -L "$TARGET" ]] || deny "${KIND} nicht installiert"
        [[ "$(stat -c %u "$TARGET")" == "$SITE_UID" ]] || deny "${KIND}-verzeichnis gehört nicht dem site-user"
    fi
else
    for d in wp-admin wp-includes; do
        [[ -d "${SITE_PATH}/${d}" && ! -L "${SITE_PATH}/${d}" && "$(stat -c %u "${SITE_PATH}/${d}")" == "$SITE_UID" ]] \
            || deny "${d} fehlt oder fremder besitzer"
    done
fi

# ── Rollback (Dateien, bei rollback-db zusätzlich die Datenbank) ───────────
if [[ "$MODE" == rollback || "$MODE" == rollback-db ]]; then
    if [[ "$KIND" == core ]]; then
        OLD_VERSION=$(wp_field core version)
        STATUS_BEFORE="-"
    elif [[ -e "$TARGET" ]]; then
        OLD_VERSION=$(wp_field "$KIND" get "$SLUG" --field=version)
        STATUS_BEFORE=$(wp_field "$KIND" get "$SLUG" --field=status)
    else
        STATUS_BEFORE="fehlt"   # abgebrochenes Update: Verzeichnis ist weg, nur einsetzen
    fi
    if [[ "$MODE" == rollback-db ]]; then
        # Sicherung des aktuellen Stands, bevor irgendetwas angefasst wird; liegt im Snapshot-Verzeichnis
        BEFORE_DUMP="${SNAP_DIR}/db-before-rollback-${TS}.sql.gz"
        [[ ! -e "$BEFORE_DUMP" ]] || fail "sicherungs-dump existiert schon"
        dump_db "$BEFORE_DUMP" || fail "sicherung vor dem rollback: ${DUMP_MSG}"
        DB_DUMP="$BEFORE_DUMP"
    fi
    if [[ "$KIND" == core ]]; then restore_core_files; else restore_item_files; fi
    if [[ "$MODE" == rollback-db ]]; then
        set +e
        IMP_OUT=$(zcat "${SNAP_DIR}/db.sql.gz" | wp_user db import - --skip-plugins --skip-themes 2>&1); IMP_RC=$?
        set -e
        # Nur der mysql-Fehlercode: der Freitext zitiert Anweisungen und Werte aus dem Dump (Datenbankinhalt)
        [[ $IMP_RC -eq 0 ]] || fail "wp db import exit ${IMP_RC} ($(sql_code "$IMP_OUT")) — dateien zurückgespielt, datenbank möglicherweise teilweise importiert; erneut rollback-db ${ARG} möglich; stand vor dem rollback: ${BEFORE_DUMP##*/} (nur manuell per wp db import)"
    fi
    wp_user cache flush >/dev/null 2>&1 || true
    if [[ "$KIND" == core ]]; then
        NEW_VERSION=$(wp_field core version); STATUS_AFTER="-"
    else
        NEW_VERSION=$(wp_field "$KIND" get "$SLUG" --field=version)
        STATUS_AFTER=$(wp_field "$KIND" get "$SLUG" --field=status)
    fi
    IS_INSTALLED=$( wp_user core is-installed >/dev/null 2>&1 && echo yes || echo no )
    HTTP=$(http_status)
    EXPECT="${META_STATUS:-$STATUS_BEFORE}"; [[ "$KIND" != core ]] || EXPECT="-"
    if [[ -n "$NEW_VERSION" && "$STATUS_AFTER" == "$EXPECT" && "$IS_INSTALLED" == yes && "$HTTP" =~ ^[23] ]]; then
        OK=true; emit 0
    fi
    fail "smoke-test nach rollback fehlgeschlagen (status ${STATUS_BEFORE}->${STATUS_AFTER}, erwartet ${EXPECT}, installed=${IS_INSTALLED}, http=${HTTP})"
fi

# ── Update: Vorprüfung ─────────────────────────────────────────────────────
TARGET_VERSION=""
if [[ "$KIND" == core ]]; then
    OLD_VERSION=$(wp_field core version)
    [[ "$OLD_VERSION" =~ $CORE_VER_RE ]] || fail "core: version nicht lesbar"
    STATUS_BEFORE="-"
    # Nur Versionen, die WordPress selbst anbietet: kein Downgrade, kein --force, kein Nightly
    AVAIL=$( { wp_user core check-update --fields=version --format=csv 2>/dev/null | tail -n +2 | grep -E "$CORE_VER_RE"; } || true )
    [[ -n "$AVAIL" ]] || fail "core: kein update verfügbar (${OLD_VERSION})"
    if [[ "$ARG" != latest ]]; then
        grep -qxF "$ARG" <<<"$AVAIL" || fail "core: version ${ARG} wird nicht angeboten (verfügbar: $(tr '\n' ' ' <<<"$AVAIL"))"
        TARGET_VERSION="$ARG"
    fi
else
    OLD_VERSION=$(wp_field "$KIND" get "$SLUG" --field=version)
    [[ -n "$OLD_VERSION" ]] || fail "${KIND} ${SLUG}: version nicht lesbar"
    STATUS_BEFORE=$(wp_field "$KIND" get "$SLUG" --field=status)
    # "update" gibt es nur bei list (get kennt das Feld nicht); --name filtert auf den Slug
    UPD=$(wp_field "$KIND" list --name="$SLUG" --field=update --format=csv)
    [[ "$UPD" == available ]] || fail "${KIND} ${SLUG}: kein update verfügbar (update=${UPD:-?})"
fi

# ── Snapshot (root schreibt nur hier; der Site-User liefert tar und Dump über stdout) ──
install -d -m 700 -o root -g root "$BACKUP_ROOT" "${BACKUP_ROOT}/${DOMAIN}"
FREE_KB=$(df --output=avail -k "$BACKUP_ROOT" | tail -n 1 | tr -d ' ')
[[ "$FREE_KB" =~ ^[0-9]+$ && "$FREE_KB" -ge "$MIN_FREE_KB" ]] || fail "zu wenig platz unter ${BACKUP_ROOT} (${FREE_KB:-?} kB frei)"
SNAP_DIR="${BACKUP_ROOT}/${DOMAIN}/dashy-${TS}-${SLUG}"
[[ ! -e "$SNAP_DIR" ]] || fail "snapshot-verzeichnis existiert schon"
mkdir -m 700 "$SNAP_DIR"
printf 'kind=%s\nslug=%s\nold_version=%s\nstatus=%s\nts=%s\n' "$KIND" "$SLUG" "$(safe "$OLD_VERSION" "$VERSION_RE")" "$(safe "$STATUS_BEFORE" "$STATUS_RE")" "$TS" > "${SNAP_DIR}/meta"
if [[ "$KIND" == core ]]; then
    mapfile -t ROOT_FILES < <(core_root_files)
    [[ ${#ROOT_FILES[@]} -ge ${#CORE_REQUIRED[@]} ]] || { rm -rf "$SNAP_DIR"; fail "core-root-dateien fehlen im webroot"; }
    if ! as_user tar -czf - -C "$SITE_PATH" -- wp-admin wp-includes "${ROOT_FILES[@]}" > "${SNAP_DIR}/files.tar.gz" 2>/dev/null; then
        rm -rf "$SNAP_DIR"; fail "datei-snapshot fehlgeschlagen"
    fi
    MEMBERS=$(tar -tzf "${SNAP_DIR}/files.tar.gz" 2>/dev/null) || MEMBERS=""
    check_core_members "$MEMBERS" || { rm -rf "$SNAP_DIR"; fail "datei-snapshot unbrauchbar"; }
else
    if ! as_user tar -czf - -C "$PARENT" -- "$SLUG" > "${SNAP_DIR}/files.tar.gz" 2>/dev/null; then
        rm -rf "$SNAP_DIR"; fail "datei-snapshot fehlgeschlagen"
    fi
    MEMBERS=$(tar -tzf "${SNAP_DIR}/files.tar.gz" 2>/dev/null) || MEMBERS=""
    check_members "$SLUG" "$MEMBERS" || { rm -rf "$SNAP_DIR"; fail "datei-snapshot unbrauchbar"; }
fi
dump_db "${SNAP_DIR}/db.sql.gz" || { rm -rf "$SNAP_DIR"; fail "$DUMP_MSG"; }
chmod 600 "${SNAP_DIR}"/*
SNAPSHOT="$SNAP_DIR"; DB_DUMP="${SNAP_DIR}/db.sql.gz"
# Retention: die letzten KEEP Plugin-/Theme-Snapshots und getrennt die letzten KEEP_CORE Core-Snapshots je Domain
# (Namen sortieren chronologisch). Getrennt, damit eine „Alle aktualisieren"-Serie den Core-Snapshot nicht verdrängt.
mapfile -t OLD_SNAPS < <(find "${BACKUP_ROOT}/${DOMAIN}" -mindepth 1 -maxdepth 1 -type d -name 'dashy-*' ! -name '*-core' -printf '%f\n' | sort | head -n -"$KEEP")
mapfile -t OLD_CORE < <(find "${BACKUP_ROOT}/${DOMAIN}" -mindepth 1 -maxdepth 1 -type d -name 'dashy-*-core' -printf '%f\n' | sort | head -n -"$KEEP_CORE")
for s in "${OLD_SNAPS[@]}" "${OLD_CORE[@]}"; do rm -rf "${BACKUP_ROOT:?}/${DOMAIN:?}/${s:?}"; done

# ── Update ─────────────────────────────────────────────────────────────────
if [[ "$KIND" == core ]]; then
    UPD_ARGS=(core update); [[ -z "$TARGET_VERSION" ]] || UPD_ARGS+=("--version=${TARGET_VERSION}")
    set +e
    UPD_OUT=$(wp_user "${UPD_ARGS[@]}" 2>&1); UPD_RC=$?
    set -e
    NEW_VERSION=$(wp_field core version)
    if [[ $UPD_RC -ne 0 ]]; then
        fail "wp core update exit ${UPD_RC}: $(wp_msg "$UPD_OUT") — rollback-db: ${SNAP_DIR##*/} (entfernt auch .maintenance)"
    fi
    [[ "$NEW_VERSION" != "$OLD_VERSION" ]] || fail "version unverändert (${OLD_VERSION}): $(wp_msg "$UPD_OUT") — rollback-db: ${SNAP_DIR##*/}"
    [[ -z "$TARGET_VERSION" || "$NEW_VERSION" == "$TARGET_VERSION" ]] || fail "version ${NEW_VERSION} statt ${TARGET_VERSION} — rollback-db: ${SNAP_DIR##*/}"
    # Schema nachziehen; ohne diesen Schritt läuft WordPress nach einem Major-Release mit alter db_version
    set +e
    DBU_OUT=$(wp_user core update-db 2>&1); DBU_RC=$?
    set -e
    STATUS_AFTER="-"
    wp_user cache flush >/dev/null 2>&1 || true
    IS_INSTALLED=$( wp_user core is-installed >/dev/null 2>&1 && echo yes || echo no )
    HTTP=$(http_status)
    [[ $DBU_RC -eq 0 ]] || fail "wp core update-db exit ${DBU_RC}: $(wp_msg "$DBU_OUT") — rollback-db: ${SNAP_DIR##*/}"
    if [[ "$IS_INSTALLED" != yes || ! "$HTTP" =~ ^[23] ]]; then
        fail "smoke-test fehlgeschlagen (installed=${IS_INSTALLED}, http=${HTTP}) — rollback-db: ${SNAP_DIR##*/}"
    fi
    OK=true; emit 0
fi

set +e
UPD_OUT=$(wp_user "$KIND" update "$SLUG" 2>&1); UPD_RC=$?
set -e
NEW_VERSION=$(wp_field "$KIND" get "$SLUG" --field=version)
STATUS_AFTER=$(wp_field "$KIND" get "$SLUG" --field=status)
wp_user cache flush >/dev/null 2>&1 || true
IS_INSTALLED=$( wp_user core is-installed >/dev/null 2>&1 && echo yes || echo no )
HTTP=$(http_status)
if [[ $UPD_RC -ne 0 ]]; then
    fail "wp ${KIND} update exit ${UPD_RC}: $(wp_msg "$UPD_OUT")"
fi
if [[ "$NEW_VERSION" == "$OLD_VERSION" ]]; then
    fail "version unverändert (${OLD_VERSION}): $(wp_msg "$UPD_OUT")"
fi
if [[ "$STATUS_AFTER" != "$STATUS_BEFORE" || "$IS_INSTALLED" != yes || ! "$HTTP" =~ ^[23] ]]; then
    fail "smoke-test fehlgeschlagen (status ${STATUS_BEFORE}->${STATUS_AFTER}, installed=${IS_INSTALLED}, http=${HTTP}) — rollback: ${SNAP_DIR##*/}"
fi
OK=true; emit 0
